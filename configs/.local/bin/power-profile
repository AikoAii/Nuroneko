#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
Usage:
    power-profile balance
    power-profile powersave
    power-profile performance
    power-profile status
EOF
    exit 1
}

case "${1:-}" in
    balance)
        exec "$SCRIPT_DIR/power/power-profile-balance"
        ;;

    powersave)
        exec "$SCRIPT_DIR/power/power-profile-powersave"
        ;;

    performance)
        exec "$SCRIPT_DIR/power/power-profile-performance"
        ;;

    status)
        exec "$SCRIPT_DIR/power/power-profile-status"
        ;;

    *)
        usage
        ;;
esac

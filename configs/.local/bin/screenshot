#!/usr/bin/env bash

set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

mkdir -p "$DIR"

notify() {
  notify-send -i camera-photo "Screenshot" "$1"
}

usage() {
  echo "Usage: screenshot {full|region}"
  exit 1
}

case "${1:-}" in
full)
  grim "$FILE"
  wl-copy <"$FILE"
  notify "Fullscreen copied"
  ;;

region)
  grim -g "$(slurp)" "$FILE"
  wl-copy <"$FILE"
  notify "Region copied"
  ;;

*)
  usage
  ;;
esac

#!/usr/bin/env bash

set -euo pipefail

WALL_DIR="$HOME/.local/share/wallpapers"
CACHE_DIR="$HOME/.cache/wallpaper-random"
QUEUE="$CACHE_DIR/queue"

mkdir -p "$CACHE_DIR"

if [[ ! -s "$QUEUE" ]]; then
    find "$WALL_DIR" \
        -maxdepth 1 \
        -type f \
        ! -name "current" \
        | shuf > "$QUEUE"
fi

IMG="$(head -n 1 "$QUEUE")"

[[ -n "$IMG" ]] || exit 1

tail -n +2 "$QUEUE" > "$QUEUE.tmp"
mv "$QUEUE.tmp" "$QUEUE"

exec wallpaper-set "$IMG"

#!/usr/bin/env bash

set -euo pipefail

WALL_DIR="$HOME/.local/share/wallpapers"
THEME="$HOME/.config/rofi/themes/selecting.rasi"

selected="$(
    find "$WALL_DIR" \
        -maxdepth 1 \
        -type f \
        ! -name "current" \
        | sort \
        | while read -r img; do
            printf "%s\0icon\x1f%s\n" "$img" "$img"
        done \
        | rofi -dmenu -theme "$THEME"
)"

[[ -z "$selected" ]] && exit 0

exec wallpaper-set "$selected"

// Nuroneko Rofi — Catppuccin Mocha
configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    display-drun:        " ";
    display-run:         " ";
    display-filebrowser: " ";
    display-window:      " ";
    drun-display-format: "{name}";
    window-format:       "{w}{t}";
    font:                "JetBrainsMono Nerd Font 10";
    icon-theme:          "Papirus";
}

@theme "theme"

// ── Window ─────────────────────────────────────────
window {
    width:            42em;
    transparency:     "real";
    fullscreen:       false;
    enabled:          true;
    cursor:           "default";
    spacing:          0em;
    padding:          0em;
    border:           1px;
    border-radius:    18px;
    border-color:     @main-br;
    background-color: @main-bg;
}

mainbox {
    enabled:          true;
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         [ "dummywall", "listbox" ];
    background-color: transparent;
}

// ── Left panel ───
dummywall {
    spacing:          0em;
    padding:          0em;
    width:            12em;
    expand:           false;
    orientation:      horizontal;
    children:         [ "mode-switcher" ];
    border-radius:    17px 0px 0px 17px;
    background-color: transparent;
    background-image: url("~/.cache/rofi/wallpaper.png", height);
}


mode-switcher {
    enabled:          true;
    orientation:      vertical;
    width:            68px;
    margin:           0em 0em 0em 0.7em;
    padding:          2.8em 0em;
    spacing:          0.55em;
    background-color: transparent;
}

button {
    cursor:           pointer;
    width:            2.6em;
    padding:          0em;
    border:           1px;
    border-radius:    10px;
    border-color:     @main-br;
    background-color: @glass;
    text-color:       @main-fg;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

button selected {
    border-color:     @main-ex;
    background-color: @main-ex;
    text-color:       @on-accent;
}


// ── Right panel ─────────
listbox {
    spacing:          0.65em;
    padding:          1em;
    children:         [ "inputbar", "listview" ];
    background-color: transparent;
}

inputbar {
    enabled:          true;
    children:         [ prompt, entry ];
    spacing:          0.2em;
    padding:          0.3em 0.6em;
    border:           1px;
    border-radius:    12px;
    border-color:     @main-br;
    background-color: @surface;
    text-color:       @main-fg;
}

prompt {
    enabled:          true;
    padding:          0.4em 0.5em;
    vertical-align:   0.5;
    cursor:           default;
    background-color: transparent;
    text-color:       @main-ex;
}

entry {
    enabled:          true;
    padding:          0.4em 0.4em;
    vertical-align:   0.5;
    cursor:           text;
    placeholder:      "Search…";
    placeholder-color: @dim;
    background-color: transparent;
    text-color:       @main-fg;
}

listview {
    enabled:          true;
    spacing:          4px;
    padding:          0em;
    columns:          1;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    cursor:           "default";
    background-color: transparent;
    text-color:       @main-fg;
}

// List Item Container
element {
    enabled:          true;
    spacing:          0.9em;
    padding:          0.45em 0.8em;
    border:           1px;
    border-radius:    11px;
    border-color:     transparent;
    cursor:           pointer;
    background-color: transparent;
    text-color:       @main-fg;
}

element normal.active {
    text-color:       @main-ex;
}

element normal.urgent {
    text-color:       @urgent;
}

element selected.normal,
element selected.active {
    border-color:     @select-br;
    background-color: @select-bg;
    text-color:       @select-fg;
}

element selected.urgent {
    border-color:     @urgent;
    background-color: @select-bg;
    text-color:       @urgent;
}

element-icon {
    size:             1.8em;
    vertical-align:   0.5;
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           inherit;
    highlight:        bold underline;
    background-color: transparent;
    text-color:       inherit;
}

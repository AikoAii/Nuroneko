// General Config
configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    display-drun:        " ";
    display-run:         " ";
    display-filebrowser: " ";
    display-window:      " ";
    drun-display-format: "{name}";
    window-format:       "{w}{t}";
    font:                "JetBrainsMono Nerd Font 10";
    icon-theme:          "Tela-circle-dracula";
}

@theme "theme"

// Main Window
window {
    height:           24em;
    width:            45em;
    transparency:     "real";
    fullscreen:       false;
    enabled:          true;
    cursor:           "default";
    spacing:          0em;
    padding:          0em;
    border:           1px;
    border-radius:    18px;
    border-color:     @main-br;
    background-color: @main-bg;
}

// Main Layout Container
mainbox {
    enabled:          true;
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         [ "dummywall", "listbox" ];
    background-color: transparent;
}

// Left Image Panel
dummywall {
    spacing:          0em;
    padding:          0em;
    width:            15em;
    expand:           false;
    orientation:      horizontal;
    children:         [ "mode-switcher" ];
    background-color: transparent;
    background-image: url("~/.cache/rofi/wallpaper.png", height);
}

// Mode Switcher Sidebar
mode-switcher {
    orientation:      vertical;
    enabled:          true;
    width:            3.2em;
    padding:          5.5em 0em 5.5em 0.6em;
    spacing:          0.7em;
    background-color: transparent;
}

// Mode Switcher Buttons
button {
    cursor:           pointer;
    padding:          0px;
    border-radius:    12px;
    background-color: @main-bg;
    text-color:       @main-fg;
}

// Active Mode Button
button selected {
    background-color: @main-fg;
    text-color:       @main-bg;
}

// Right Container
listbox {
    spacing:          0.8em;
    padding:          1.2em;
    children:         [ "inputbar", "listview" ];
    background-color: transparent;
}

// Search Bar Box
inputbar {
    enabled:          true;
    children:         [ prompt, entry ];
    spacing:          0em;
    padding:          0em;
    cursor:           pointer;
    background-color: transparent;
    text-color:       @main-fg;
}

// Search Icon/Prompt
prompt {
    enabled:          true;
    padding:          0.55em 0.9em;
    text-align:       center;
    cursor:           default;
    text-color:       @select-fg;
    border:           1px;
    border-radius:    12px 0px 0px 12px;
    border-color:     @main-br;
    background-color: @main-br;
}

// Search Input Field
entry {
    enabled:          true;
    padding:          0.55em 0.9em;
    cursor:           text;
    border:           1px;
    border-radius:    0px 12px 12px 0px;
    border-color:     @main-br;
    background-color: @main-bg;
    text-color:       @main-fg;
}

// Item List View
listview {
    enabled:          true;
    spacing:          5px;
    padding:          0em;
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    expand:           true;
    fixed-height:     true;
    fixed-columns:    true;
    cursor:           "default";
    background-color: transparent;
    text-color:       @main-fg;
}

// List Item Container
element {
    enabled:          true;
    spacing:          0.8em;
    padding:          0.55em 0.8em;
    cursor:           pointer;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @main-fg;
}

// Active/Selected Item
element selected.normal {
    background-color: @select-bg;
    text-color:       @select-fg;
    border-radius:    12px;
}

// Item Icon
element-icon {
    size:             1.8em;
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}

// Item Text Label
element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}

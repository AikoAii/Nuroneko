// General Config
configuration {
    modi:       "drun";
    show-icons: false;
    font:       "JetBrainsMono Nerd Font 10";
}

@theme "theme"

// Main Window
window {
    height:           30em;
    width:            48em;
    transparency:     "real";
    fullscreen:       false;
    enabled:          true;
    cursor:           "default";
    spacing:          0em;
    padding:          0em;
    border:           1px;
    border-radius:    20px;
    border-color:     @main-br;
    background-color: @main-bg;
}

// Content Container
mainbox {
    enabled:          true;
    orientation:      vertical;
    spacing:          1em;
    padding:          1.3em;
    children:         [ "inputbar", "listview" ];
    background-color: transparent;
}

// Search Bar Box
inputbar {
    enabled:          true;
    children:         [ prompt, entry ];
    spacing:          0.5em;
    padding:          0.25em;
    cursor:           pointer;
    background-color: @main-bg;
    text-color:       @main-fg;
    border:           1px;
    border-radius:    15px;
    border-color:     @main-br;
}

// Search Badge/Label
prompt {
    enabled:          true;
    padding:          0.6em 0.9em;
    text-align:       center;
    cursor:           default;
    text-color:       @select-fg;
    background-color: @select-bg;
    border-radius:    11px;
}

// Text Input Field
entry {
    enabled:          true;
    expand:           true;
    padding:          0.6em 0.7em;
    cursor:           text;
    background-color: transparent;
    text-color:       @main-fg;
    placeholder:      "Search shortcuts...";
    placeholder-color: @main-fg;
}

// Keybind List View
listview {
    enabled:          true;
    spacing:          5px;
    padding:          0.2em 0em 0em 0em;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    cursor:           "default";
    background-color: transparent;
    text-color:       @main-fg;
}

// List Item
element {
    enabled:          true;
    spacing:          1em;
    padding:          0.65em 0.9em;
    cursor:           pointer;
    border-radius:    13px;
    background-color: transparent;
    text-color:       @main-fg;
}

// Active/Selected Item
element selected.normal {
    background-color: @select-bg;
    text-color:       @select-fg;
    border-radius:    13px;
}

// Item Text Content
element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}

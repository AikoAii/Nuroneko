// Nuroneko Rofi — Keyboard shortcuts
configuration {
    modi:       "drun";
    show-icons: false;
    font:       "JetBrainsMono Nerd Font 10";
}

@import "theme"
@import "base"

window {
    location:         center;
    anchor:           center;
    width:            42em;
    transparency:     "real";
    fullscreen:       false;
    border:           1px;
    border-radius:    18px;
    border-color:     @main-br;
    background-color: @main-bg;
    padding:          0em;
}

mainbox {
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
    spacing:          0.65em;
    padding:          1em;
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          0.3em;
    padding:          0.3em 0.6em;
    border:           1px;
    border-radius:    12px;
    border-color:     @main-br;
    background-color: @surface;
    text-color:       @main-fg;
}

prompt {
    enabled:          true;
    str:              "󰌌";
    padding:          0.4em 0.5em;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       @main-ex;
}

entry {
    placeholder:       "Search shortcuts…";
    placeholder-color: @dim;
    padding:           0.4em;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        @main-fg;
}

listview {
    columns:          1;
    lines:            8;
    spacing:          4px;
    padding:          0em;
    layout:           vertical;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    fixed-columns:    true;
    background-color: transparent;
    text-color:       @main-fg;
}

element {
    spacing:          0.8em;
    padding:          0.55em 0.8em;
    border:           1px;
    border-radius:    10px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @main-fg;
}

element alternate.normal {
    background-color: @glass;
}

element normal.active {
    text-color:       @main-ex;
}

element normal.urgent {
    text-color:       @urgent;
}

element selected.normal,
element selected.active {
    border-color:     @select-br;
    background-color: @select-bg;
    text-color:       @select-fg;
}

element selected.urgent {
    border-color:     @urgent;
    background-color: @select-bg;
    text-color:       @urgent;
}

element-icon {
    size:             1.6em;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    highlight:        bold;
    background-color: transparent;
    text-color:       inherit;
}

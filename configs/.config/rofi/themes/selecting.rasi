// Configuration
configuration {
    modi:               "drun";
    show-icons:         true;
    drun-display-format: "{name}";
    font:               "JetBrainsMono NF Bold 11";
}

@theme "theme"

// Window
window {
    enabled:            true;
    fullscreen:         false;
    width:              80%;
    height:             16em;
    transparency:       "real";
    cursor:             "default";
    spacing:            0px;
    padding:            0px;
    border:             1px;
    border-radius:      18px;
    border-color:       @main-br;
    background-color:   @main-bg;
}

// Main Box
mainbox {
    enabled:            true;
    spacing:            0px;
    padding:            0px;
    children:           [ "listview" ];
    background-color:   transparent;
}

// Wallpaper Grid
listview {
    enabled:            true;
    columns:            5;
    lines:              1;
    spacing:            6px;
    padding:            6px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    reverse:            false;
    fixed-height:       true;
    fixed-columns:      true;
    cursor:             "default";
    background-color:   transparent;
    text-color:         @main-fg;
}

// Wallpaper Item
element {
    enabled:            true;
    orientation:        vertical;
    spacing:            0px;
    padding:            2px;
    border:             2px;
    border-radius:      12px;
    border-color:       transparent;
    cursor:             pointer;
    background-color:   transparent;
    text-color:         @main-fg;
}

// Selected State
element selected.normal {
    background-color:   transparent;
    text-color:         @select-fg;
    border-color:       @select-bg;
    border-radius:      12px;
}

// Thumbnail
element-icon {
    size:               280px;
    cursor:             inherit;
    border-radius:      9px;
    background-color:   transparent;
    horizontal-align:   0.5;
}

// Hide Filename Text
element-text {
    enabled:            false;
}

// Responsive Media Query
@media(max-aspect-ratio: 1.8) {
    element {
        orientation:    vertical;
    }
}

// Nuroneko Rofi — Wallpaper selector
configuration {
    modi:                "drun";
    show-icons:          true;
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 10";
    icon-theme:          "Papirus";
}

@import "theme"
@import "base"

window {
// set position
    location:         center;
    anchor:           center;
    y-offset:         -1.2em;
    width:            82%;
    transparency:     "real";
    fullscreen:       false;
    border:           1px;
    border-radius:    20px;
    border-color:     @main-br;
    background-color: @main-bg;
    padding:          0em;
}

mainbox {
    orientation:      vertical;
    children:         [ "listview" ];
    spacing:          0em;
    padding:          0.25em;
    background-color: transparent;
}

listview {
    columns:          5;
    lines:            1;
    spacing:          8px;
    padding:          0px;
    layout:           vertical;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    fixed-columns:    true;
    background-color: transparent;
    text-color:       @main-fg;
}

element {
    orientation:      vertical;
    padding:          2px;
    border:           1px;
    border-radius:    12px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @main-fg;
}

element selected.normal,
element selected.active {
    border-color:     @select-br;
    background-color: @select-bg;
    text-color:       @select-fg;
}

element-icon {
    size:             280px;
    //squared:          false;
    border-radius:    10px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    enabled:          false;
}

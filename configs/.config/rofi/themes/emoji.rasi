
/* Nuroneko — Emoji Picker */

configuration {
    show-icons: false;
    font:       "Noto Color Emoji 14";
}

@theme "theme"

window {
    width:            32em;
    transparency:     "real";
    fullscreen:       false;
    border:           1px;
    border-radius:    18px;
    border-color:     @main-br;
    background-color: @main-bg;
    padding:          0em;
}

mainbox {
    orientation:      vertical;
    children:         [ "inputbar", "listview" ];
    spacing:          0.5em;
    padding:          0.8em;
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          0.2em;
    padding:          0.25em 0.55em;
    border:           1px;
    border-radius:    12px;
    border-color:     @main-br;
    background-color: @surface;
    text-color:       @main-fg;
}

prompt {
    enabled:          true;
    str:              "🙂";
    font:             "Noto Color Emoji 12";
    padding:          0.3em 0.4em;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       @main-ex;
}

entry {
    font:              "JetBrainsMono Nerd Font 10";
    placeholder:       "Search emoji…";
    placeholder-color: @dim;
    padding:           0.3em;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        @main-fg;
}

listview {
    columns:          8;
    lines:            5;
    spacing:          4px;
    flow:             horizontal;
    layout:           vertical;
    padding:          0.1em 0em;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     true;
    fixed-columns:    true;
    background-color: transparent;
    text-color:       @main-fg;
}

element {
    children:         [ element-text ];
    padding:          0.25em 0.1em;
    border:           1px;
    border-radius:    9px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @main-fg;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected.normal {
    border-color:     @select-br;
    background-color: @select-bg;
    text-color:       @select-fg;
}

element-text {
    font:             "Noto Color Emoji 14";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

{
  "positionX": "right",
  "positionY": "top",

  "layer": "overlay",
  "control-center-layer": "overlay",

  "control-center-exclusive-zone": false,
  "layer-shell-cover-screen": false,

  "notification-window-width": 380,
  "control-center-width": 410,

  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,

  "fit-to-screen": true,

  "control-center-margin-top": 10,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 10,

  "notification-grouping": false,

  "cssPriority": "user",

  "widgets": [
    "title",
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },

    "buttons-grid": {
      "buttons-per-row": 2,

      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },

        {
          "label": "󰂯",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },

        {
          "label": "󰂛",
          "type": "toggle",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && swaync-client --dnd-on || swaync-client --dnd-off'",
          "update-command": "sh -c 'swaync-client --get-dnd | grep -q true && echo true || echo false'"
        },

        {
          "label": "󰐥",
          "command": "wlogout"
        }
      ]
    },

    "backlight": {
      "label": "󰃠",
      "device": "amdgpu_bl1",
      "subsystem": "backlight",
      "min": 1
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },

    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false
    },

    "dnd": {
      "text": "Do Not Disturb"
    },

    "notifications": {
      "vexpand": false
    }
  }
}
